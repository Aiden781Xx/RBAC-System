# Vite — copy to .env and fill in values

# API base URL (leave blank to use Vite proxy /api → localhost:8000)
# VITE_API_URL=http://localhost:8000/api

# Google OAuth Client ID (from Google Cloud Console → APIs & Services → Credentials)
# Create an OAuth 2.0 Client ID of type "Web application"
# Authorised JS origins: http://localhost:5173
# Authorised redirect URIs: http://localhost:5173
# Then paste the Client ID here:
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
